# Copy to .env (which is gitignored). Never commit real values.
PORT=3000
# The secret you typed in the GitHub App's "Webhook secret" field
WEBHOOK_SECRET=change-me
GITHUB_APP_ID=123456
# Contents of the downloaded .pem, with newlines written as \n, all on one line
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional: without a key the app still runs the rule-based checks and skips LLM summaries.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-5-5 (cheapest tier). Check Anthropic's docs for current model IDs.
LLM_MODEL=

# Optional, only for the evaluation scripts (npm run eval:collect): a personal access token that can
# read PUBLIC repositories. Never commit it.
GITHUB_TOKEN=
